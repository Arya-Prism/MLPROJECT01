# GEMINI_API_KEY: Required for server-side Gemini AI routes (/api/ai/generate-event and /api/ai/recommend).
# Never commit real API keys. Copy this file to .env.local for local development.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# APP_URL: Base URL where this application is hosted (optional for local development).
APP_URL="http://localhost:3000"
